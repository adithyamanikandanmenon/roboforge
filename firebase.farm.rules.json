{
  "rules": {
    ".read": false,
    ".write": false,
    "water_quality": {
      "$pond": {
        "readings": {
          ".read": true,
          ".indexOn": ["timestamp"],
          "$reading": {
            ".write": "auth != null && (auth.token.sensor_writer === true || auth.token.farm_owner === true) && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['timestamp'])",
            "timestamp": {
              ".validate": "newData.isNumber() || newData.isString()"
            }
          }
        }
      }
    },
    "pond_profiles": {
      ".read": true,
      "$pond": {
        ".write": "auth != null && auth.token.farm_owner === true && newData.exists()",
        ".validate": "newData.hasChildren(['id','name','path','targets','staleMinutes']) && newData.child('id').val() === $pond",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "bodyType": {
          ".validate": "newData.val() === 'Pond' || newData.val() === 'Tank' || newData.val() === 'Lake' || newData.val() === 'Reservoir' || newData.val() === 'River' || newData.val() === 'Canal' || newData.val() === 'Other'"
        },
        "sensorChecks": {
          "$sensor": {
            ".validate": "($sensor === 'ph' || $sensor === 'temperature' || $sensor === 'dissolved_oxygen' || $sensor === 'turbidity' || $sensor === 'tds' || $sensor === 'air_temperature' || $sensor === 'aqi' || $sensor === 'rainfall') && newData.hasChildren(['checkEveryDays','calibrateEveryDays','jumpLimit','maxGapMinutes'])",
            "checkedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000 && (!data.exists() || newData.val() >= data.val())"
            },
            "calibratedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000 && (!data.exists() || newData.val() >= data.val())"
            },
            "checkEveryDays": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 3650"
            },
            "calibrateEveryDays": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 3650"
            },
            "jumpLimit": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000"
            },
            "maxGapMinutes": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1440"
            },
            "comparePair": { ".validate": "newData.isBoolean()" },
            "pairTolerance": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 14"
            },
            "pairMaxSkewSeconds": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 3600"
            },
            "$other": { ".validate": false }
          }
        },
        "path": {
          ".validate": "newData.isString() && newData.val().length <= 240"
        },
        "fishSpecies": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "photoUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "staleMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1440"
        },
        "targets": {
          ".validate": "newData.hasChildren(['ph','temperature','dissolved_oxygen','turbidity','tds'])",
          "$metric": {
            ".validate": "newData.hasChild('min') || newData.hasChild('max')",
            "min": {
              ".validate": "newData.isNumber() && (!newData.parent().hasChild('max') || newData.val() <= newData.parent().child('max').val())"
            },
            "max": {
              ".validate": "newData.isNumber() && (!newData.parent().hasChild('min') || newData.val() >= newData.parent().child('min').val())"
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "farm_activity": {
      "$pond": {
        ".read": "auth != null && auth.token.farm_owner === true",
        "$entry": {
          ".write": "auth != null && auth.token.farm_owner === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id','type','note','time','createdAt']) && newData.child('id').val() === $entry",
          "id": { ".validate": "newData.isString()" },
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "care_reminders": {
      "$pond": {
        ".read": "auth != null && auth.token.farm_owner === true",
        "$reminder": {
          ".write": "auth != null && auth.token.farm_owner === true && root.child('pond_profiles').child($pond).exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id','pondId','title','kind','dueAt','repeat','createdAt','updatedAt']) && newData.child('id').val() === $reminder && newData.child('pondId').val() === $pond",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "pondId": { ".validate": "newData.isString()" },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "kind": {
            ".validate": "newData.val() === 'Feeding' || newData.val() === 'Cleaning' || newData.val() === 'Sensor check' || newData.val() === 'Other'"
          },
          "dueAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "repeat": {
            ".validate": "newData.val() === 'none' || newData.val() === 'daily' || newData.val() === 'weekly'"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000 && (!data.exists() || data.val() === newData.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000 && (!data.exists() || newData.val() >= data.val())"
          },
          "completedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "lastCompletedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "archivedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "alert_ack": {
      "$pond": {
        ".read": "auth != null && auth.token.farm_owner === true",
        "$alert": {
          ".write": "auth != null && auth.token.farm_owner === true && newData.exists()",
          ".validate": "newData.hasChildren(['time','note'])",
          "time": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "notification_tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.farm_owner === true",
        "$token": {
          ".write": "auth != null && auth.uid === $uid && auth.token.farm_owner === true",
          ".validate": "newData.hasChildren(['token','pondId','updatedAt'])",
          "token": {
            ".validate": "newData.isString() && newData.val().length <= 4096"
          },
          "pondId": {
            ".validate": "newData.isString() && root.child('pond_profiles').child(newData.val()).exists()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "server_alert_state": { ".read": false, ".write": false },
    "server_reminder_state": { ".read": false, ".write": false },
    "server_alert_log": {
      ".read": "auth != null && auth.token.farm_owner === true",
      ".write": false
    }
  }
}
